# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=3001

# 0.0.0.0 lets a phone on the same Wi-Fi reach the API. Use 127.0.0.1 for this computer only.
HOST=0.0.0.0

# curated (default) shows only the 91 selected products; full shows the whole catalogue.
CATALOGUE_MODE=curated

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_sql_password
DB_NAME=SmartBasketDemo
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=60000

# Browser origins allowed to call the API (the staff console runs on port 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=8h

# Staff logins. Create a hash from the server folder with:
# node -e "import('bcryptjs').then(({default:b}) => console.log(b.hashSync('your-password', 12)))"
CASHIER_USERNAME=cashier
CASHIER_PASSWORD_HASH=replace-with-bcrypt-hash
CASHIER_DISPLAY_NAME=Cashier

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_DISPLAY_NAME=Admin

# Folder of product photos, and the URL prefix the API uses for them.
PRODUCT_IMAGE_DIR=product-images
PRODUCT_IMAGE_PUBLIC_PATH=/product-images

# Demo only: shows simulated item weights on the cashier screen (no real scale).
SIMULATED_BASKET_WEIGHT=false
